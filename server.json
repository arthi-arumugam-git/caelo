{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.arthi-arumugam-git/caelo",
  "title": "Caelo",
  "description": "Security scanner for AI-built apps, not a CMS. Finds exposed keys and open databases. Free, MIT.",
  "version": "0.1.2",
  "websiteUrl": "https://caelo.sh",
  "repository": {
    "url": "https://github.com/arthi-arumugam-git/caelo",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "caelo",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--mcp",
          "description": "Run Caelo as an MCP server over stdio",
          "isRequired": true
        }
      ]
    }
  ]
}
