{
  "name": "caelo",
  "version": "0.1.3",
  "description": "Caelo security scanner: a local MCP server plus a /caelo:scan command. Finds exposed API keys, secrets leaked to the browser, and open databases in project code. Reads files only, uploads nothing.",
  "author": {
    "name": "Irth Labs",
    "url": "https://www.irthlabs.com"
  },
  "homepage": "https://caelo.sh",
  "repository": "https://github.com/arthi-arumugam-git/caelo",
  "license": "MIT",
  "icon": "./.claude-plugin/icon.png",
  "keywords": ["security", "scanner", "mcp", "secrets", "api-keys", "supabase", "firebase", "ai-apps"],
  "network": {
    "hosts": ["registry.npmjs.org"]
  },
  "mcpServers": {
    "scanner": {
      "command": "npx",
      "args": ["-y", "caelo", "--mcp"]
    }
  }
}
